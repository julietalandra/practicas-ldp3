@page
@model PracticasLDP3.Pages.Guia05.listadoarticulosModel
@{ ViewData["Title"] = "Listado de artículos"; }
<link rel="stylesheet" href="~/css/practicas456.css" asp-append-version="true" />
<section class="pr-panel">
<header class="pr-header"><span class="pr-kicker">GUÍA 05</span><h1>Listado de artículos</h1><p>JOIN entre artículos y rubros, con parámetros.</p></header>
@if (!string.IsNullOrWhiteSpace(Model.Mensaje))
{
    <p class="pr-mensaje" role="status">@Model.Mensaje</p>
}@if (Model.Consultado)
{
    if (Model.Lista.Count == 0) { <p class="pr-vacio">No hay artículos para mostrar</p> }
    else
    {
        <div class="pr-tabla-scroll"><table class="pr-tabla"><caption>Artículos encontrados: @Model.Lista.Count</caption>
        <thead><tr><th>Código</th><th>Descripción</th><th>Precio</th><th>Rubro</th></tr></thead><tbody>
        @foreach (var a in Model.Lista)
        {
            <tr><td>@a.Codigo</td><td>@a.Descripcion</td><td>@(a.Precio?.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-AR")) ?? "Sin precio")</td><td>@a.Rubro</td></tr>
        }
        </tbody></table></div>
    }
}<p class="pr-volver"><a asp-page="/Guia05/Index">← Volver a la guía 05</a></p>
</section>
