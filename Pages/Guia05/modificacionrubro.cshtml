@page
@model PracticasLDP3.Pages.Guia05.modificacionrubroModel
@{ ViewData["Title"] = "Modificación de rubros"; }
<link rel="stylesheet" href="~/css/practicas456.css" asp-append-version="true" />
<section class="pr-panel">
<header class="pr-header"><span class="pr-kicker">GUÍA 05</span><h1>Modificación de rubros</h1><p>ABM con ADO.NET y consultas parametrizadas.</p></header>
<form method="post"><div class="pr-campo"><label asp-for="Codigo">Código</label>
<input asp-for="Codigo" type="number" min="1" /><span asp-validation-for="Codigo" class="pr-error"></span></div><div class="pr-campo"><label asp-for="Descripcion">Descripción</label>
<input asp-for="Descripcion" type="text" maxlength="50" /><span asp-validation-for="Descripcion" class="pr-error"></span></div><div class="pr-acciones"><button asp-page-handler="Buscar" class="pr-btn secundario" type="submit">Buscar</button><button asp-page-handler="Guardar" class="pr-btn" type="submit">Guardar cambios</button></div></form>@if (!string.IsNullOrWhiteSpace(Model.Mensaje))
{
    <p class="pr-mensaje" role="status">@Model.Mensaje</p>
}<p class="pr-volver"><a asp-page="/Guia05/Index">← Volver a la guía 05</a></p>
</section>
