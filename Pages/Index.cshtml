@page
@model IndexModel
@{
    ViewData["Title"] = "Laboratorio de Programación 3";
}

<section class="hero">
    <span class="badge-course">Tecnicatura en Desarrollo de Software</span>

    <h1>Laboratorio de Programación 3</h1>

    <h4> <i>
        Prácticas y ejercicios realizados durante la materia
        utilizando ASP.NET Core y Razor Pages.
        </i>
    </h4>
    <p> 
        Instituto Superior Santo Domingo <br />
        Profesor: Mansilla Cristian
    </p>
</section>

<section class="practicas">
    <h2>Prácticas</h2>

    <div class="practicas-grid">

        <article class="practica-card">
            <span class="numero">Clase 01</span>

            <h3>Introducción a Razor Pages</h3>

            <p>
                Primeros ejercicios con Razor Pages, formularios,
                handlers y procesamiento de datos.
            </p>

            <a asp-page="/Guia01/Index" class="btn-practica">
                Ver práctica →
            </a>
        </article>

        <article class="practica-card">
            <span class="numero">Clase 02</span>

            <h3>Archivos de texto</h3>

            <p>
                En esta guía se trabaja con el almacenamiento de información en archivos de texto dentro del servidor.
            </p>

            <a asp-page="/Guia02/Index" class="btn-practica">
                Ver práctica →
            </a>
        </article>

    </div>
</section>
