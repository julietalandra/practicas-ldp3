@page
@model IndexModel
@{
    ViewData["Title"] = "Guía 01";
}

<link rel="stylesheet" href="~/css/guia01.css" />

<div class="guia-container">

    <header class="guia-header">
        <span class="guia-numero">GUÍA 01</span>
        <h1>Introducción a Razor Pages</h1>
        <p>Primeros ejercicios con formularios, handlers y procesamiento de datos.</p>
        <span class="fecha">Hoy es @Model.FechaHoy</span>
    </header>


    <section class="ejercicios-grid">

        <!-- CONTADOR -->
        <article class="ejercicio-card">
            <span class="ejercicio-numero">Ejercicio 01</span>
            <h2>Contador</h2>
            <p class="descripcion">Incrementa el valor cada vez que se presiona el botón.</p>

            <div class="contador">
                @Model.Contador
            </div>

            <form method="post" asp-page-handler="Contador">
                <input type="hidden" name="Contador" value="@Model.Contador" />

                <button type="submit" class="btn-guia">
                    Sumar
                </button>
            </form>
        </article>


        <!-- SUMA -->
        <article class="ejercicio-card">
            <span class="ejercicio-numero">Ejercicio 02</span>
            <h2>Suma de dos valores</h2>
            <p class="descripcion">Ingresa dos números para obtener su suma.</p>

            <form method="post" asp-page-handler="Suma">

                <div class="mb-3">
                    <label class="form-label">Primer valor</label>
                    <input type="number" name="X1" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Segundo valor</label>
                    <input type="number" name="X2" class="form-control" />
                </div>

                <button type="submit" class="btn-guia">
                    Sumar
                </button>

            </form>

            @if (!string.IsNullOrEmpty(Model.Mensaje1))
            {
                <div class="resultado">
                    @Model.Mensaje1
                </div>
            }
        </article>


        <!-- RADIO BUTTON -->
        <article class="ejercicio-card">
            <span class="ejercicio-numero">Ejercicio 03</span>
            <h2>Sumar o restar</h2>
            <p class="descripcion">Selecciona una de las dos operaciones.</p>

            <form method="post" asp-page-handler="SumaoResta">

                <div class="mb-3">
                    <label class="form-label">Primer valor</label>
                    <input type="number" name="X1" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Segundo valor</label>
                    <input type="number" name="X2" class="form-control" />
                </div>

                <div class="opciones">
                    <label>
                        <input type="radio" name="Operacion" value="Sumar" checked />
                        Sumar
                    </label>

                    <label>
                        <input type="radio" name="Operacion" value="Restar" />
                        Restar
                    </label>
                </div>

                <button type="submit" class="btn-guia">
                    Calcular
                </button>

            </form>

            @if (!string.IsNullOrEmpty(Model.Mensaje2))
            {
                <div class="resultado">
                    @Model.Mensaje2
                </div>
            }
        </article>


        <!-- CHECKBOX -->
        <article class="ejercicio-card">
            <span class="ejercicio-numero">Ejercicio 04</span>
            <h2>Sumar y/o restar</h2>
            <p class="descripcion">Permite seleccionar una o ambas operaciones.</p>

            <form method="post" asp-page-handler="SumaYOResta">

                <div class="mb-3">
                    <label class="form-label">Primer valor</label>
                    <input type="number" name="X1" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Segundo valor</label>
                    <input type="number" name="X2" class="form-control" />
                </div>

                <div class="opciones">
                    <label>
                        <input type="checkbox" name="Operaciones" value="Sumar" />
                        Sumar
                    </label>

                    <label>
                        <input type="checkbox" name="Operaciones" value="Restar" />
                        Restar
                    </label>
                </div>

                <button type="submit" class="btn-guia">
                    Calcular
                </button>

            </form>

            @if (!string.IsNullOrEmpty(Model.Mensaje3))
            {
                <div class="resultado">
                    @Html.Raw(Model.Mensaje3)
                </div>
            }
        </article>


        <!-- LISTBOX -->
        <article class="ejercicio-card ejercicio-grande">
            <span class="ejercicio-numero">Ejercicio 05</span>
            <h2>Cálculo con ListBox</h2>
            <p class="descripcion">Selecciona una o varias operaciones matemáticas.</p>

            <form method="post" asp-page-handler="ListBox">

                <div class="inputs-dobles">
                    <div>
                        <label class="form-label">Primer valor</label>
                        <input type="number" name="X1" class="form-control" />
                    </div>

                    <div>
                        <label class="form-label">Segundo valor</label>
                        <input type="number" name="X2" class="form-control" />
                    </div>
                </div>

                <div class="mb-3 mt-3">
                    <label class="form-label">Operaciones</label>

                    <select name="Operaciones"
                            multiple
                            size="4"
                            class="form-select">
                        <option value="Sumar">Sumar</option>
                        <option value="Restar">Restar</option>
                        <option value="Multiplicar">Multiplicar</option>
                        <option value="Dividir">Dividir</option>
                    </select>
                </div>

                <button type="submit" class="btn-guia">
                    Calcular
                </button>

            </form>

            @if (!string.IsNullOrEmpty(Model.Mensaje4))
            {
                <div class="resultado">
                    @Html.Raw(Model.Mensaje4)
                </div>
            }
        </article>

    </section>

</div>