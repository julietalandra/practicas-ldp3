@page
@model PracticasLDP3.Pages.Guia02.CargarModel
@{
    ViewData["Title"] = "Ingresar comentario";
}

<link rel="stylesheet" href="~/css/guia02.css" />

<div class="form-container">

    <div class="mb-4">
        <span class="guia-numero">LIBRO DE VISITAS</span>
        <h1>Dejá tu comentario</h1>
        <p class="text-muted">Completá los datos para registrarlos en el libro de visitas.</p>
    </div>

    <form method="post">

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <input type="text" name="Nombre" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">País</label>
            <input type="text" name="Pais" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Comentario</label>
            <textarea name="Comentarios"
                      rows="4"
                      class="form-control"></textarea>
        </div>

        <button type="submit" class="btn btn-dark">
            Guardar comentario
        </button>

    </form>

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-success mt-4">
            @Model.Mensaje
        </div>
    }

    <div class="mt-4">
        <a asp-page="/Guia02/Index" class="volver">
            ← Volver a la Guía 02
        </a>
    </div>

</div>